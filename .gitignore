# ==============================================================================
# M.A.C.H. AI — Git Ignore Specifications
# ==============================================================================

# ── Python Bytecode & Compilation ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── Virtual Environments ──
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ── Caches & Test Frameworks ──
.ruff_cache/
.pytest_cache/
.mypy_cache/
backend/cache/
htmlcov/
.coverage
.coverage.*
.tox/
.nox/

# ── Local Environment & Secrets ──
.env
.env.local
.env.*.local
*.key
*.pem
*.cert
*.crt

# ── Uploads & Runtime Storage ──
uploads/
backend/uploads/
*.pdf
*.pptx
*.dump

# Exclude generated crops/diagrams from repo root, but preserve static frontend assets
*.png
*.jpg
*.jpeg
*.svg
!frontend/icons/*
!frontend/favicon.ico
!frontend/src/**/*.svg

# ── Benchmark Logs & Telemetry ──
scripts/benchmark_results.json
*.log

# ── IDEs, Editors & OS Files ──
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── Docker Local Overrides ──
docker-compose.override.yml
*.docker.log
