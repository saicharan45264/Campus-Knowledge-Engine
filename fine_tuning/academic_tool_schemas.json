[
  {
    "type": "function",
    "function": {
      "name": "lookup_academic_calendar",
      "description": "Find cohort or semester reopening and the date midterm/end-semester exams commence, plus holidays and working Saturdays. Use this for semester-level exam commencement dates.",
      "parameters": {
        "type": "object",
        "properties": {
          "event_type": {
            "type": "string",
            "enum": [
              "commencement",
              "midterm",
              "endsem",
              "holiday",
              "working_saturday",
              "general"
            ]
          },
          "term": {
            "type": "string",
            "enum": [
              "odd",
              "even",
              "all"
            ]
          },
          "target_date": {
            "type": "string"
          },
          "target_month": {
            "type": "string"
          },
          "cohort": {
            "type": "string"
          },
          "temporal_scope": {
            "type": "string",
            "enum": [
              "next",
              "all",
              "specific",
              "general"
            ]
          },
          "festival": {
            "type": "string"
          }
        },
        "required": [
          "event_type",
          "temporal_scope"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "lookup_class_timetable",
      "description": "Find a student's weekly class schedule, course slot, venue, faculty, or lunch break.",
      "parameters": {
        "type": "object",
        "properties": {
          "course_code": {
            "type": "string"
          },
          "weekday": {
            "type": "string"
          },
          "slot_number": {
            "type": "integer"
          },
          "query_type": {
            "type": "string",
            "enum": [
              "venue",
              "faculty",
              "time_slot",
              "day_schedule",
              "lunch_break",
              "general"
            ]
          },
          "department": {
            "type": "string"
          },
          "semester": {
            "type": "string"
          },
          "class_name": {
            "type": "string"
          }
        },
        "required": [
          "query_type"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "lookup_elective_directory",
      "description": "Find elective bucket offerings, courses, faculty, or venues.",
      "parameters": {
        "type": "object",
        "properties": {
          "elective_bucket": {
            "type": "string",
            "enum": [
              "PE-IV",
              "PE-V",
              "PE-VI",
              "free_elective",
              "all"
            ]
          }
        },
        "required": [
          "elective_bucket"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "lookup_lab_schedule",
      "description": "Find lab sessions, vacant time, or lab venue from an uploaded lab timetable.",
      "parameters": {
        "type": "object",
        "properties": {
          "lab_identifier": {
            "type": "string"
          },
          "weekday": {
            "type": "string"
          },
          "check_vacant_only": {
            "type": "boolean"
          },
          "department": {
            "type": "string"
          },
          "semester": {
            "type": "string"
          }
        },
        "required": [
          "lab_identifier"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "lookup_exam_schedule",
      "description": "Find course-level mid-term or end-semester timetable entries, including each course's date and session. Use this only for course schedule lookups; use the academic calendar for when a semester or cohort's exams commence.",
      "parameters": {
        "type": "object",
        "properties": {
          "course_code": {
            "type": "string"
          },
          "department": {
            "type": "string"
          },
          "semester": {
            "type": "string"
          },
          "exam_type": {
            "type": "string",
            "enum": [
              "end_sem",
              "mid_term"
            ]
          }
        },
        "required": [
          "exam_type"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "lookup_exam_seating",
      "description": "Find the signed-in student's exam room and seat from the registered roll number.",
      "parameters": {
        "type": "object",
        "properties": {
          "register_number": {
            "type": "string"
          },
          "department": {
            "type": "string"
          },
          "semester": {
            "type": "string"
          }
        },
        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "lookup_curriculum_concept",
      "description": "Find syllabus units, outcomes, prerequisites, Bloom taxonomy, credits, or L-T-P-C.",
      "parameters": {
        "type": "object",
        "properties": {
          "course_code_or_name": {
            "type": "string"
          },
          "aspect": {
            "type": "string",
            "enum": [
              "prerequisites",
              "unit_syllabus",
              "course_outcomes",
              "blooms_taxonomy",
              "credits_ltpc",
              "general"
            ]
          },
          "unit_number": {
            "type": "integer"
          }
        },
        "required": [
          "course_code_or_name",
          "aspect"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "lookup_academic_regulations",
      "description": "Find academic rules, regulation clauses, attendance, grading, re-registration, exams, promotion, or honors.",
      "parameters": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string"
          },
          "clause_number": {
            "type": "string"
          }
        },
        "required": [
          "topic"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "lookup_past_exam_questions",
      "description": "Find past-year questions by course, topic, exam type, or marks.",
      "parameters": {
        "type": "object",
        "properties": {
          "course_code_or_name": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "exam_type": {
            "type": "string",
            "enum": [
              "mid_term",
              "end_sem",
              "all"
            ]
          },
          "marks": {
            "type": "integer"
          }
        },
        "required": []
      }
    }
  }
]
