# CurriculumLens Backend — Environment Variables
# Copy this to .env and update values for your environment

# ── App ──
APP_NAME=CurriculumLens
APP_VERSION=0.1.0
DEBUG=true
API_PREFIX=/api/v1

# ── PostgreSQL ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=curriculumlens
POSTGRES_USER=cluser
POSTGRES_PASSWORD=clpassword

# ── Qdrant ──
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_TEXT=cl_text_embeddings
QDRANT_COLLECTION_VISUAL=cl_visual_embeddings

# ── Neo4j ──
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=clpassword

# ── Elasticsearch ──
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=cl_documents

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── LLM ──
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ── Embedding ──
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# ── VACI ──
VACI_MODEL=Qwen/Qwen2-VL-7B-Instruct
VACI_DEVICE=auto

# ── Document Processing ──
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=100
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Security ──
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── CORS ──
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
