# ==============================================================================
# M.A.C.H. AI — Docker Build Context Exclusions
# ==============================================================================

# ── Python Virtual Environments & Caches ──
venv/
.venv/
env/
backend/venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
tests/cache/
backend/cache/

# ── Version Control & Tooling ──
.git/
.gitignore
.github/

# ── Local Secrets & Environment ──
# Injected at runtime via docker-compose env_file, not baked into the image
.env
.env.local
*.pem
*.key

# ── Uploads, PDFs & Test Documents ──
uploads/
backend/uploads/
tests/test_data/*.pdf
*.pdf
*.pptx
*.dump

# ── Runtime Logs & Benchmark Output ──
backend/scripts/benchmark_results.json
*.log

# ── Docker Configuration Files ──
docker-compose.yml
docker-compose.override.yml
Dockerfile
.dockerignore

# ── IDEs, Editors & OS Files ──
.DS_Store
.idea/
.vscode/
Thumbs.db
