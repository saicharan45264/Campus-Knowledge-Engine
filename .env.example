# ==============================================================================
# M.A.C.H. AI — Environment Template (.env.example)
# Copy this file to .env and configure your parameters:
#   cp .env.example .env
# ==============================================================================

# ── Ollama LLM & Embedding Server ──
# Local: http://localhost:11434
# Docker: http://host.docker.internal:11434
# Google Colab Ngrok Tunnel: https://xxxx.ngrok-free.app
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b-it-qat
OLLAMA_EMBED_MODEL=embeddinggemma-2:latest

# ── Cloudinary (CDN Question Diagram Storage) ──
# Free account at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── PostgreSQL with pgvector (Document Text & 768d Vector Store) ──
# Native host execution uses port 5434 (mapped from Docker 5432)
# Docker Compose backend service uses host 'postgres' and port 5432
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=mach_ai
POSTGRES_USER=mach
POSTGRES_PASSWORD=ai

# ── Neo4j 5.x (Property Graph Database & Knowledge Engine) ──
# Native host execution: bolt://localhost:7687
# Docker Compose backend service: bolt://neo4j:7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mach_ai_cke

# ── Security, Sessions & JWT Authentication ──
JWT_SECRET=replace_with_secure_random_secret_key_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── Runtime Environment & CORS ──
# Set HEADLESS_MODE=true and APP_ENV=production when running inside Docker
# For production HTTPS deployment, set CORS_ORIGINS=https://mach.amrita.edu
HEADLESS_MODE=false
APP_ENV=development
CORS_ORIGINS=*
